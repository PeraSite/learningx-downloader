{
  "name": "learningx-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/prepare.ts && tsc --noEmit && bun run scripts/build.ts && bun run scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "bun run scripts/e2e.ts",
    "package": "bun run scripts/package.ts"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/core": "0.12.10",
    "fast-xml-parser": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.3.10",
    "@types/chrome": "^0.1.24",
    "typescript": "^5.9.3"
  }
}
